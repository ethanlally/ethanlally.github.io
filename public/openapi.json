{
  "openapi": "3.1.0",
  "info": {
    "title": "Ethan Lally Portfolio API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://lally.lol"
    }
  ],
  "paths": {
    "/api/reading": {
      "get": {
        "summary": "Current public Hardcover reading activity",
        "description": "Most recently updated public currently-reading book, cached for one hour per edge location. May return labeled last-known data during an upstream outage.",
        "responses": {
          "200": {
            "description": "Book or empty shelf, with updatedAt and stale fields"
          },
          "503": {
            "description": "Reading service unavailable or not configured"
          }
        }
      }
    },
    "/api/github": {
      "get": {
        "summary": "Recent public GitHub repositories",
        "responses": {
          "200": {
            "description": "Repository list"
          }
        }
      }
    },
    "/api/spotify": {
      "get": {
        "summary": "Current Spotify playback state",
        "responses": {
          "200": {
            "description": "Playback state"
          }
        }
      }
    }
  }
}

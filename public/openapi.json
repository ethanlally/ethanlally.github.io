{
  "openapi": "3.1.0",
  "info": {
    "title": "Ethan Lally Portfolio API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://lally.lol"
    }
  ],
  "paths": {
    "/api/github": {
      "get": {
        "summary": "Recent public GitHub repositories",
        "responses": {
          "200": {
            "description": "Repository list"
          }
        }
      }
    },
    "/api/spotify": {
      "get": {
        "summary": "Current Spotify playback state",
        "responses": {
          "200": {
            "description": "Playback state"
          }
        }
      }
    }
  }
}

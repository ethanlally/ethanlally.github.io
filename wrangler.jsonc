{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ethanlally",
  "compatibility_date": "2026-04-08",
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/ethan/browser",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "NG_DISABLE_VERSION_CHECK=1 npm run build"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
